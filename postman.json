  "item": [
    {
      "name": "Auth",
      "description": "Custom stateful sessions. Login creates an HMAC-signed token + DB row in `sessions`. The cookie holds `<uuid>.<hmac>` — middleware verifies the signature in Edge without a DB query; server code also checks the DB row exists and is not expired. Logout deletes the DB row immediately.",
      "item": [
        {
          "name": "Sign in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Verifies credentials, creates a row in the `sessions` table, and sets an HttpOnly `session_token` cookie. No CSRF token required."
          }
        },
        {
          "name": "Get session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "session"]
            },
            "description": "Returns `{ user: { id, email, name } }` when authenticated, or `{}` when unauthenticated. Validates the cookie HMAC and the DB session row on every call."
          }
        },
        {
          "name": "Sign out",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": ""
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Deletes the session row from the `sessions` table and clears the `session_token` cookie. Session is immediately invalid — no grace period."
          }
        }
      ]
    },
